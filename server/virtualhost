<VirtualHost *:80>
    ServerName     www.agromwinda.com
    ServerAlias    *.agromwinda.com
    RewriteEngine  On
    RewriteCond %{HTTP_HOST} ^(.+)\.agromwinda\.com$
    RewriteRule ^(.*)$ https://%1.agromwinda.com$1 [R=302,L]
    RewriteRule    ^(.*)$   https://%{HTTP_HOST}%{REQUEST_URI}
</VirtualHost>
